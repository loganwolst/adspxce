# Secret used to sign login session cookies. Set this to a long random string
# in production — anyone who knows it can forge a login session.
SESSION_SECRET=change-me-to-a-long-random-string

# Set automatically by most hosts (Render, Railway, etc.) — override locally if needed.
PORT=3000

# Stripe — advertiser deposits. Leave unset and the app still runs fine
# (the "Pay with card" button just shows "not configured yet"); the
# existing demo top-up keeps working either way. Get these from
# dashboard.stripe.com — use TEST mode keys (start with sk_test_ / whsec_)
# until you're actually ready to take real payments.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
